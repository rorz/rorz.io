{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "cache": {
    "enabled": true
  },
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "images": {
    "binding": "IMAGES"
  },
  "main": "src/worker.ts",
  "name": "rorz-io",
  "routes": [
    {
      "custom_domain": true,
      "pattern": "rorz.io"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_POSTHOG_HOST": "/x",
    "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN": "phc_ufKQAPQ2uWNyoQTGC3C3VkDs5TkuKQkaxVf4wPcFwky2"
  }
}
