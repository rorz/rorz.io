@@ -0,0 +1,23 @@
+#!/usr/bin/env node
+const fs = require("node:fs");
+const Module = require("node:module");
+const path = require("node:path");
+
+const cliPath = path.join(__dirname, "cli.js");
+const source = fs.readFileSync(cliPath, "utf8");
+const syncFileDownMarker =
+  'async syncFileDown(e,t){let i=t.path;if(this.log("Downloading",i),t.folder){';
+const syncFileDownReplacement =
+  'async syncFileDown(e,t){let i=t.path;if(this.adapter.insensitive){let n=Object.keys(this.adapter.files).find(r=>r!==i&&r.toLowerCase()===i.toLowerCase());n&&await this.adapter.rename(n,i)}if(this.log("Downloading",i),t.folder){';
+const markerCount = source.split(syncFileDownMarker).length - 1;
+
+if (markerCount !== 1) {
+  throw new Error(
+    `Cannot patch obsidian-headless: expected one syncFileDown marker, found ${markerCount}.`,
+  );
+}
+
+const cliModule = new Module(cliPath, module);
+cliModule.filename = cliPath;
+cliModule.paths = Module._nodeModulePaths(__dirname);
+cliModule._compile(source.replace(syncFileDownMarker, syncFileDownReplacement), cliPath);
