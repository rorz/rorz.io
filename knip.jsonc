{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [".pokayoke/rules/**/*.rule.ts", ".pokayoke/rules/**/*.test.ts"],
      "project": [".pokayoke/**/*.ts"],
      "ignoreDependencies": ["obsidian-headless"]
    },
    "apps/web": {
      "entry": [
        "app/**/{default,error,layout,loading,not-found,page,route,template}.{ts,tsx}",
        "app/styles.css"
      ],
      "project": ["app/**/*.{ts,tsx}"]
    }
  },
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "exports",
    "types",
    "nsExports",
    "nsTypes",
    "duplicates",
    "enumMembers",
    "namespaceMembers",
    "catalog",
    "cycles"
  ],
  "includeEntryExports": false,
  "treatConfigHintsAsErrors": true,
  "treatTagHintsAsErrors": true
}
