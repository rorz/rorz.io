{
  "name": "rorz.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run --filter @rorz/web dev",
    "build": "bun run --filter @rorz/web build",
    "start": "bun run --filter @rorz/web start",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check:biome": "biome check .",
    "check:biome:fix": "biome check --write .",
    "check:biome:fix:unsafe": "biome check --write --unsafe .",
    "check:vinext": "bun run --filter @rorz/web check:vinext",
    "typecheck": "tsc --noEmit && bun run --filter obsidian-oxide typecheck && bun run --filter @rorz/web typecheck",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "pokayoke": "pokayoke check",
    "pokayoke:fix": "pokayoke check --fix",
    "test": "bun test apps packages ./.pokayoke/rules/*.test.ts",
    "check": "bun run check:biome && bun run typecheck && bun run knip && bun run test && bun run pokayoke && bun run check:vinext",
    "verify": "bun run check && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "knip": "^6.25.0",
    "obsidian-headless": "^0.0.13",
    "pokayoke": "^0.0.6",
    "typescript": "^7.0.2"
  }
}
