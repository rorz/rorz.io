{
  "ensure_final_newline_on_save": true,
  "format_on_save": "on",
  "languages": {
    "CSS": {
      "code_actions_on_format": {
        "source.fixAll.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome"]
    },
    "HTML": {
      "code_actions_on_format": {
        "source.fixAll.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "..."]
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "vtsls", "!typescript-language-server", "!eslint"]
    },
    "JSON": {
      "code_actions_on_format": {
        "source.fixAll.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "json-language-server"]
    },
    "JSONC": {
      "code_actions_on_format": {
        "source.fixAll.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "json-language-server"]
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "vtsls", "!typescript-language-server", "!eslint"]
    },

    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "language_servers": ["biome", "vtsls", "!typescript-language-server", "!eslint"]
    }
  },
  "line_ending": "prefer_lf",
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    }
  },
  "tasks": {
    "enabled": true,
    "prefer_lsp": false
  }
}
