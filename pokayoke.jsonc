{
  "$schema": "https://pokayoke.codes/schema.json",
  "extends": ["pokayoke/recommended", "pokayoke/typescript/recommended"],
  "localRules": [".pokayoke/rules/**/*.rule.ts"],
  "files": [
    ".pokayoke/rules/**/*.ts",
    ".zed/*.json",
    "AGENTS.md",
    "README.md",
    "apps/web/app/**/*.ts",
    "apps/web/app/**/*.tsx",
    "apps/web/package.json",
    "apps/web/tsconfig.json",
    "apps/web/vite.config.ts",
    "biome.json",
    "knip.jsonc",
    "package.json",
    "pokayoke.jsonc",
    "tsconfig.json"
  ],
  "ignores": ["**/node_modules/**", "**/dist/**", "**/.vinext/**", "**/*.d.ts"],
  "suppressions": {
    "directive": "pokayoke-ignore",
    "requireReason": true,
    "reportUnused": "error"
  },
  "rules": {
    "package/no-npx-in-scripts": "error",
    "repo/tooling-contract": "error",
    "structure/max-file-lines": ["error", { "max": 300 }],
    "typescript/enforce-arrow-function": "error"
  }
}
